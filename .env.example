# ---------------------------------------------------------------
# LudoApp · plantilla de configuración
# 1) Copia este archivo con el nombre  .env  (sin ".example")
# 2) Rellena los valores. NO uses comillas ni espacios alrededor del "=".
# 3) NO pongas comentarios al final de una línea de valor (van en su propia línea).
# 4) NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# ---------------------------------------------------------------

# Supabase > Connect (o Project Settings > API): "Project URL"
SUPABASE_URL=https://TU-REF.supabase.co

# Clave pública: sb_publishable_...  (o la clave "anon" de Legacy API Keys)
SUPABASE_KEY=

# Clave SECRETA (solo servidor): sb_secret_...  (o "service_role" de Legacy API Keys)
# Da acceso total a tu BD: jamás la pegues en el front ni la compartas.
SUPABASE_SERVICE_KEY=

# Frase larga y aleatoria para firmar los tokens de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Puerto de la API (opcional, por defecto 3100)
PORT=3100

# OPCIONAL y NO recomendado si ya ejecutaste el SQL a mano: déjalo comentado.
# Si lo usas, copia el "Session pooler" desde Connect (termina en pooler.supabase.com:5432).
# No uses db.TU-REF.supabase.co: es IPv6 y falla en redes solo IPv4.
# DATABASE_URL=
